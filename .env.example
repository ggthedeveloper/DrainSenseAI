# DrainSense India Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database (PostgreSQL with fallback to SQLite for local development)
DATABASE_URL=sqlite:///./drainsense.db
# DATABASE_URL=postgresql://drainsense_user:drainsense_pass@localhost:5432/drainsense

# Security & Admin Access
ADMIN_TOKEN=drainsense_admin_secure_key_2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML & Data Settings
MODEL_PATH=models/drainsense_xgb_v1.joblib
MODEL_METADATA_PATH=models/drainsense_xgb_v1_metadata.json
DATA_DIR=data

# Optional Public API Tokens (Open-Meteo & NWDP public telemetry do not require keys by default)
IMD_TELEMETRY_KEY=
CWC_API_KEY=
